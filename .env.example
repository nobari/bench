# Canonical site URL (used for metadata, sitemap, OG, llms.txt).
# On Vercel this is derived automatically; set it for custom domains.
NEXT_PUBLIC_SITE_URL=https://bench.tools

# "Suggest a tool" → GitHub Issues integration.
# Without a token the form falls back to opening a prefilled GitHub issue.
# owner/repo that should receive tool-suggestion issues:
GITHUB_REPO=nobari/bench
# A fine-grained PAT with "Issues: write" on that repo:
GITHUB_TOKEN=

# URL shortener (/web/short-url) — the one server-backed tool. Provisioned with
# `vercel blob create-store <name> --access private --yes`, then `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
# Optional cap for the link store in bytes (default 500 MB — half the Hobby Blob quota).
# SHORTLINK_MAX_STORE_BYTES=524288000
